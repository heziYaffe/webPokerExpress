{
  "name": "webpokerexpress",
  "version": "1.0.0",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "jest --runInBand",
    "make-admin": "node server/scripts/makeAdmin.js"
  },
  "keywords": [],
  "author": "heziYaffe",
  "license": "MIT",
  "description": "Multiplayer Texas Hold'em poker: Express + MongoDB + WebSocket server with a React client",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/server"
    ],
    "setupFiles": [
      "<rootDir>/server/__tests__/setupEnv.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
